{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "caixadoce-nine.vercel.app"
        }
      ],
      "destination": "https://www.caixadoce.com.br/:path*",
      "permanent": true
    }
  ]
}
